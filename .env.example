# ---------------------------------------------------------------------------
# Turso / libSQL
# ---------------------------------------------------------------------------
# Local development: leave the file: URL below (no token needed).
# Production: use the URL and token from `turso db show imgblue --url`
#             and `turso db tokens create imgblue`.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Public base URL
# ---------------------------------------------------------------------------
# Used for Open Graph metadata and docs. Links returned by the API use the
# incoming request origin, so this is optional. Set it on Vercel to your
# production URL (or custom domain) so social previews are absolute.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Allow uploads without an account. Defaults to false (accounts required).
ALLOW_PUBLIC_UPLOADS=false
