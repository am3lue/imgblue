# ---------------------------------------------------------------------------
# Turso / libSQL
# ---------------------------------------------------------------------------
# Local development: leave the file: URL below (no token needed).
# Production: use the URL and token from `turso db show imgblue --url`
#             and `turso db tokens create imgblue`.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Public base URL
# ---------------------------------------------------------------------------
# Used for canonical URLs, Open Graph metadata, the sitemap, and docs. Links
# returned by the API use the incoming request origin. Set this on Vercel to
# your production URL (or custom domain) so SEO metadata is absolute.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Allow uploads without an account. Defaults to false (accounts required).
ALLOW_PUBLIC_UPLOADS=false

# Bing Webmaster Tools verification (msvalidate.01 meta tag). Google
# verification is handled by public/google2ef11ddbde2a3e16.html.
MICROSOFT_SITE_VERIFICATION=
